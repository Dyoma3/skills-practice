<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Log in · Skills Practice</title>
    <style>
      :root {
        color-scheme: light;
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          sans-serif;
        background: #f4f5f7;
        color: #172033;
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-height: 100vh;
        margin: 0;
        display: grid;
        place-items: center;
        padding: 24px;
      }

      main {
        width: min(100%, 400px);
        padding: 32px;
        border: 1px solid #dde1e8;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 18px 45px rgb(23 32 51 / 8%);
      }

      h1 {
        margin: 0 0 8px;
        font-size: 1.75rem;
      }

      p {
        margin: 0 0 24px;
        color: #667085;
      }

      form,
      label {
        display: grid;
        gap: 8px;
      }

      form {
        gap: 18px;
      }

      label {
        font-size: 0.875rem;
        font-weight: 600;
      }

      input {
        width: 100%;
        border: 1px solid #cfd5df;
        border-radius: 10px;
        padding: 12px 14px;
        color: inherit;
        font: inherit;
      }

      input:focus {
        border-color: #4f46e5;
        outline: 3px solid rgb(79 70 229 / 15%);
      }

      button {
        border: 0;
        border-radius: 10px;
        padding: 12px 16px;
        background: #4f46e5;
        color: #ffffff;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
      }

      .error {
        margin-bottom: 18px;
        border-radius: 10px;
        padding: 12px 14px;
        background: #fef2f2;
        color: #b42318;
        font-size: 0.875rem;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Log in</h1>
      <p>Sign in to continue to Skills Practice.</p>
      @if(error)
        <div class="error" role="alert">{{ error }}</div>
      @end

      <form method="POST" action="/login">
        {{ csrfField() }}
        <label>
          
          
          
          Email



          <input
            type="email"
            name="email"
            value="{{ email }}"
            autocomplete="email"
            required
            autofocus
          />
        </label>
        <label>
          
          
          
          Password



          <input type="password" name="password" autocomplete="current-password" required />
        </label>
        <button type="submit">Log in</button>
      </form>
    </main>
  </body>
</html>
