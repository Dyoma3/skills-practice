<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Authorize access · Skills Practice</title>
    <style>
      :root {
        color-scheme: light;
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          sans-serif;
        background: #f4f5f7;
        color: #172033;
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-height: 100vh;
        margin: 0;
        display: grid;
        place-items: center;
        padding: 24px;
      }

      main {
        width: min(100%, 560px);
        padding: 32px;
        border: 1px solid #dde1e8;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 18px 45px rgb(23 32 51 / 8%);
      }

      h1 {
        margin: 0 0 8px;
        font-size: 1.75rem;
      }

      p {
        margin: 0;
        color: #667085;
      }

      dl {
        display: grid;
        gap: 20px;
        margin: 28px 0;
      }

      dt {
        margin-bottom: 6px;
        color: #667085;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      dd {
        margin: 0;
        overflow-wrap: anywhere;
      }

      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.875rem;
      }

      ul {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      li {
        border-radius: 999px;
        padding: 6px 10px;
        background: #eef2ff;
        color: #3730a3;
        font-size: 0.8rem;
        font-weight: 700;
      }

      .error {
        margin-top: 24px;
        border-radius: 10px;
        padding: 12px 14px;
        background: #fef2f2;
        color: #b42318;
        font-size: 0.875rem;
      }

      .actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 28px;
      }

      button {
        border: 0;
        border-radius: 10px;
        padding: 12px 16px;
        background: #4f46e5;
        color: #ffffff;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
      }

      button.secondary {
        border: 1px solid #cfd5df;
        background: #ffffff;
        color: #172033;
      }

      @media (max-width: 480px) {
        main {
          padding: 24px;
        }

        .actions,
        .actions form,
        button {
          width: 100%;
        }

        .actions {
          flex-direction: column-reverse;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Authorize access</h1>
      <p>An application is requesting access to Skills Practice.</p>
      @if(error)
        <div class="error" role="alert">{{ error }}</div>
      @else
        <dl>
          <div>
            <dt>Client</dt>
            <dd><code>{{ clientId }}</code></dd>
          </div>
          <div>
            <dt>Resource</dt>
            <dd><code>{{ resource }}</code></dd>
          </div>
          <div>
            <dt>Requested permissions</dt>
            <dd>
              <ul>
                @each(scope in requestedScopes)
                  <li>{{ scope }}</li>
                @end
              </ul>
            </dd>
          </div>
        </dl>
        <div class="actions">
          <form method="POST" action="/oauth/authorize/deny">
            {{ csrfField() }}
            @each(field in authorizationFields)
              <input type="hidden" name="{{ field.name }}" value="{{ field.value }}" />
            @end

            <button class="secondary" type="submit">Deny</button>
          </form>
          <form method="POST" action="/oauth/authorize/approve">
            {{ csrfField() }}
            @each(field in authorizationFields)
              <input type="hidden" name="{{ field.name }}" value="{{ field.value }}" />
            @end

            <button type="submit">Authorize</button>
          </form>
        </div>
      @end
    </main>
  </body>
</html>
